{
  "name": "@residenthiago/dsh-save-kv-cache",
  "description": "Save KV cache slot to disk on llama.cpp server, with auto-save on turn/end",
  "version": "0.2.0-alpha.3",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/residenthiago2011/DSH-Save-KV-Cache.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/residenthiago2011/DSH-Save-KV-Cache/tree/main/plugin#readme",
  "bugs": {
    "url": "https://github.com/residenthiago2011/DSH-Save-KV-Cache/issues"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
